# Kod sahipliği: Bir klasördeki değişiklik, o klasörün sahibinden onay almadan
# main dalına birleştirilemez (dal koruma kuralında "Require review from Code Owners"
# açık olmalıdır).
#
# Organizasyon: iu-dev-hub
# Öğretim üyesi: @imyo-dev-hub  (GitHub kullanıcı adınız farklıysa bu dosyadaki
# tüm @imyo-dev-hub ifadelerini kendi kullanıcı adınızla değiştirin)
#
# ÖNEMLİ: Son eşleşen satır geçerlidir.
# Burada listelenmeyen dosyalar (ör. tests/unit, tests/integration) için kod sahibi
# onayı gerekmez; dal kuralındaki "en az 1 onay" yeterlidir. Böylece öğretim üyesi
# her PR'da darboğaz olmaz.

# Modül sahipliği
/app/uyelik/            @iu-dev-hub/ekip-1
/app/katalog/           @iu-dev-hub/ekip-2
/app/odunc/             @iu-dev-hub/ekip-3
/app/ceza_rapor/        @iu-dev-hub/ekip-4
/app/templates/uyelik/      @iu-dev-hub/ekip-1
/app/templates/katalog/     @iu-dev-hub/ekip-2
/app/templates/odunc/       @iu-dev-hub/ekip-3
/app/templates/ceza_rapor/  @iu-dev-hub/ekip-4

# Ortak kod ve şema: Tüm ekipleri etkiler
/app/ortak/             @iu-dev-hub/scrum-masters
/app/templates/base.html    @iu-dev-hub/scrum-masters
/app/static/            @iu-dev-hub/scrum-masters

# Uçtan uca testler: Testçilerin onayı gerekli
/tests/e2e/             @iu-dev-hub/testciler

# Rol dağılımı ve ürün belgeleri
/ROLLER.md              @imyo-dev-hub
/docs/                  @iu-dev-hub/product-owners

# CI, depo ayarları ve bağımlılıklar: Yalnızca öğretim üyesi
/.github/               @imyo-dev-hub
/requirements.txt       @imyo-dev-hub
/pyproject.toml         @imyo-dev-hub
